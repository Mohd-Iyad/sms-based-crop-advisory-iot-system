# Copy this file to ".env" and fill in your real values.
# Never commit the real ".env" file to GitHub.

TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_TO_NUMBER=+91XXXXXXXXXX

# Which SMS provider to actually use: "twilio" (default) or "textbee".
# textbee (https://textbee.dev) turns an Android phone into the SMS sender
# using its own SIM/carrier plan -- no trial-template restriction, no
# per-message cost, no DLT registration needed for this kind of low-volume
# personal/prototype use. To use it: install the textbee app on an Android
# phone, register it at textbee.dev to get an API key, then set:
#   SMS_PROVIDER=textbee
#   TEXTBEE_API_KEY=your_textbee_api_key
SMS_PROVIDER=twilio
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# The number that receives the advisory, regardless of provider. Only
# needed if it's different from TWILIO_TO_NUMBER above -- otherwise leave
# blank and it falls back to that value automatically.
ADVISORY_TO_NUMBER=

# v5: reach more than one phone (e.g. the farmer AND a family member who
# manages the field remotely) with a comma-separated list, international
# format. If set, this replaces ADVISORY_TO_NUMBER above for who actually
# gets messaged; each number gets its own independent delivery + retries.
# Leave blank for the single-recipient behaviour above.
#   ADVISORY_TO_NUMBERS=+919876543210,+919812345678
ADVISORY_TO_NUMBERS=

# Voice + language for the phone call. Default is English (Indian voice).
# For a Kannada demo, use a supported Google Kannada voice instead, e.g.:
#   TWILIO_VOICE=Google.kn-IN-Standard-A
#   TWILIO_VOICE_LANGUAGE=kn-IN
# Do NOT use Polly.Aditi for Kannada -- it is a Hindi/Indian-English voice only.
TWILIO_VOICE=Polly.Aditi
TWILIO_VOICE_LANGUAGE=en-IN

GEMINI_API_KEY=your_gemini_api_key

# Leave blank to disable mandi price lookup (no public fallback key is
# baked into the source code anymore -- this must be your own key).
DATA_GOV_API_KEY=

# Shared secret the ESP32 must send as the X-Device-Key header. Leave blank
# to disable the check during local testing (NOT recommended once deployed).
EXPECTED_DEVICE_KEY=demo-key-123

LOCATION_NAME=Bhatkal
LOCATION_LAT=13.9853
LOCATION_LON=74.5550
MANDI_STATE=Karnataka
MANDI_DISTRICT=Uttara Kannada
MANDI_COMMODITY=Paddy

# Sowing date lives on the backend now -- the ESP32 no longer needs to know
# the calendar at all. Format: YYYY-MM-DD
SOWING_DATE=2026-06-15

# SMS timing. A NEW condition or an error is always texted immediately. While the
# same condition stays true it is texted again every ALERT_COOLDOWN_MINUTES
# (soil moisture, sensor faults, rain warning). A healthy field sends nothing.
# v5 default: 360 (6 hours) -- roughly 4 updates a day, the real-world cadence
# a farmer actually wants instead of a text every few minutes. For a fast
# on-stage demo where you want to see a repeat quickly, drop this to 5.
ALERT_COOLDOWN_MINUTES=360

# Fertilizer / harvest reminders depend only on the calendar and stay true for
# days, so they repeat far less often (minutes; 1440 = once a day).
TIME_BASED_ALERT_COOLDOWN_MINUTES=1440

# The dashboard shows "No recent data" when nothing has arrived for this many
# minutes. The ESP32 reports every 15 s; raise this if you raise its interval.
STALE_AFTER_MINUTES=2

# Set to true on a server reachable from the internet (a domain). It then refuses
# to start with a weak EXPECTED_DEVICE_KEY, hides /docs, and asks for the key on
# /sensor-data-preview. Generate a strong key with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
PUBLIC_MODE=false

# Voice calling is fully built and tested (telephony.py + llm.py) but OFF by
# default -- SMS-only is simpler to demo reliably and skips the Gemini call
# entirely too. Set to "true" to re-enable voice calls; no code changes needed.
ENABLE_VOICE_CALL=false

# Default SMS language, from built-in templates (no translation service, so
# numbers are never altered). Leave blank for English. Supported: en, hi
# (Hindi), kn (Kannada). The dashboard's language chips override this until
# the server restarts.
TRANSLATE_SMS_TO=

# ---------------------------------------------------------------------------
# Persistence + delivery worker (v3)
# ---------------------------------------------------------------------------
# SQLite locally. For a hosted deployment, point this at Postgres instead
# (e.g. postgresql+psycopg://user:pass@host/dbname) -- no code changes needed.
DATABASE_URL=sqlite:///./crop_advisory.db

# How many times a delivery job (an SMS or voice call attempt) is retried
# before it is marked failed_permanent and given up on.
SMS_RETRY_MAX_ATTEMPTS=5

# How often (seconds) the background delivery worker polls for due jobs.
WORKER_POLL_INTERVAL_SECONDS=2

# Starts the background delivery worker thread. Leave true for real use; set
# to false only for tooling that wants to process jobs manually/synchronously
# (the test suite does this automatically -- see tests/conftest.py).
ENABLE_DELIVERY_WORKER=true
